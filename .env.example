DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ar"

# Shared secret configured in the 3D engine's webhook settings
ENGINE_WEBHOOK_SECRET="change-me"
# Comma-separated hostnames the engine serves finished assets from (SSRF allowlist).
# Set this to the host of the KIRI getModelZip `modelUrl` (check it on your first test job).
ENGINE_ASSET_HOSTS="kiri-model-host.example.com"

# S3 or Cloudflare R2 (R2: S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com, S3_REGION=auto)
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET="ar-models"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# Public CDN origin mapped to the bucket, and the origin that hosts the /v/[slug] WebAR viewer
ASSET_CDN_BASE_URL="https://cdn.my-saas.com"
VIEWER_BASE_URL="https://ar.my-saas.com"

# KIRI Engine (https://docs.kiriengine.app) — 3D reconstruction provider
KIRI_API_KEY=""
# Random string; set KIRI's callback URL to https://<app>/api/webhooks/kiri?token=<KIRI_WEBHOOK_TOKEN>
KIRI_WEBHOOK_TOKEN=""
# Bearer token for GET /api/cron/kiri-sync (run every ~5 min to catch missed webhooks)
CRON_SECRET=""
